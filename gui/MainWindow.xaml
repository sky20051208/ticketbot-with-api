<Window x:Class="TicketBotWarRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MINECRAFT TICKET BOT" WindowState="Maximized" WindowStyle="None"
        ResizeMode="CanResize"
        Foreground="#FFFFFF" FontFamily="Consolas">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Background>
        <!-- 石頭灰底（像 MC 的內建 GUI 背景） -->
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3F3F3F" Offset="0"/>
            <GradientStop Color="#2A2A2A" Offset="0.5"/>
            <GradientStop Color="#3F3F3F" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <!-- ═══ Minecraft Palette ═══ -->
        <!-- Stone -->
        <SolidColorBrush x:Key="StoneLight" Color="#A4A4A4"/>
        <SolidColorBrush x:Key="StoneMid"   Color="#828282"/>
        <SolidColorBrush x:Key="StoneDark"  Color="#5C5C5C"/>
        <SolidColorBrush x:Key="StoneShadow" Color="#1C1C1C"/>
        <!-- Dirt / Wood -->
        <SolidColorBrush x:Key="DirtLight" Color="#B19370"/>
        <SolidColorBrush x:Key="DirtBrown" Color="#8B6F47"/>
        <SolidColorBrush x:Key="OakWood"   Color="#BC9862"/>
        <!-- Highlights -->
        <SolidColorBrush x:Key="GrassGreen"  Color="#5FA734"/>
        <SolidColorBrush x:Key="EmeraldGreen" Color="#3CC74D"/>
        <SolidColorBrush x:Key="DiamondCyan" Color="#5DC9C9"/>
        <SolidColorBrush x:Key="RedstoneRed" Color="#C92E2E"/>
        <SolidColorBrush x:Key="GoldYellow"  Color="#FFAA00"/>
        <SolidColorBrush x:Key="MCYellow"    Color="#FFDB28"/>
        <!-- Text -->
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDim"   Color="#A0A0A0"/>
        <SolidColorBrush x:Key="TextShadow" Color="#3F3F3F"/>

        <!-- 標題用：MC 字體陰影效果（黃字黑陰影，像 MC HUD） -->
        <DropShadowEffect x:Key="PixelShadow" Color="#3F3F3F" BlurRadius="0" ShadowDepth="2" Direction="315" Opacity="1"/>

        <!-- ═══ Text Styles ═══ -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Margin" Value="0,3,0,2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ═══ TextBox (Minecraft 樣式：黑底 + 灰邊框 + 內凹 bevel) ═══ -->
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="{StaticResource MCYellow}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource DiamondCyan}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- 外層：暗邊（陰影） -->
                        <Border Background="#1C1C1C" Padding="2">
                            <!-- 內層：MC 風內凹 bevel — 上左暗、下右亮（內凹感） -->
                            <Border x:Name="Bd"
                                    BorderThickness="2,2,1,1"
                                    BorderBrush="#3F3F3F"
                                    Background="#000000">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MCYellow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ComboBox (Minecraft 樣式) ═══ -->
        <Style x:Key="Cmb" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#3F3F3F"/>
            <Setter Property="BorderBrush" Value="#1C1C1C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#3F3F3F"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="FontFamily" Value="Consolas"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- ═══ Minecraft Button Template (3D bevel：左上亮、右下暗) ═══ -->
        <ControlTemplate x:Key="McBtnTemplate" TargetType="Button">
            <!-- 外層黑邊 (像素邊框) -->
            <Border Background="#1C1C1C">
                <!-- 中層：底色 -->
                <Border x:Name="Bd" Margin="2" Background="{TemplateBinding Background}">
                    <Grid>
                        <!-- 上邊高光 -->
                        <Border x:Name="HiTop" Height="2" VerticalAlignment="Top"
                                Background="#FFFFFF" Opacity="0.45"/>
                        <!-- 左邊高光 -->
                        <Border x:Name="HiLeft" Width="2" HorizontalAlignment="Left"
                                Background="#FFFFFF" Opacity="0.45"/>
                        <!-- 下邊陰影 -->
                        <Border x:Name="ShBot" Height="2" VerticalAlignment="Bottom"
                                Background="#000000" Opacity="0.45"/>
                        <!-- 右邊陰影 -->
                        <Border x:Name="ShRight" Width="2" HorizontalAlignment="Right"
                                Background="#000000" Opacity="0.45"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <!-- Hover：黃色描邊（像 MC 滑鼠 hover 按鈕的金邊） -->
                    <Setter Property="Foreground" Value="#FFDB28"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <!-- 按下時 bevel 反轉（變內凹） -->
                    <Setter TargetName="HiTop" Property="Background" Value="#000000"/>
                    <Setter TargetName="HiLeft" Property="Background" Value="#000000"/>
                    <Setter TargetName="ShBot" Property="Background" Value="#FFFFFF"/>
                    <Setter TargetName="ShRight" Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 共用 button base style -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template" Value="{StaticResource McBtnTemplate}"/>
        </Style>

        <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#5FA734"/>  <!-- Grass green -->
        </Style>
        <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#C92E2E"/>  <!-- Redstone red -->
        </Style>
        <Style x:Key="BtnYellow" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#FFAA00"/>  <!-- Gold -->
            <Setter Property="Foreground" Value="#1C1C1C"/>
        </Style>
        <Style x:Key="BtnCyan" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#828282"/>  <!-- Stone (中性按鈕) -->
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Top Bar (Minecraft 草地 + 泥土) ═══ -->
        <Border BorderBrush="#1C1C1C" BorderThickness="0,0,0,3">
            <Border.Background>
                <!-- 上半草綠、下半泥土，模仿 Minecraft 草方塊 -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5FA734" Offset="0"/>
                    <GradientStop Color="#5FA734" Offset="0.35"/>
                    <GradientStop Color="#8B6F47" Offset="0.40"/>
                    <GradientStop Color="#8B6F47" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="20,0">
                <!-- MC 草方塊 logo (用 4 個 Border 拼像素方塊) -->
                <Grid Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,14,0">
                    <!-- 黑邊外框 -->
                    <Border Background="#1C1C1C"/>
                    <!-- 草上層 -->
                    <Border Margin="2,2,2,24" Background="#5FA734"/>
                    <!-- 草頂高光 -->
                    <Border Margin="2,2,2,42" Background="#7FBF54"/>
                    <!-- 泥土下層 -->
                    <Border Margin="2,24,2,2" Background="#8B6F47"/>
                    <!-- 泥土暗點（像素質感） -->
                    <Border Margin="6,30,30,8" Background="#6B5237" Width="6" Height="6"
                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border Margin="0,30,8,0" Background="#6B5237" Width="6" Height="6"
                            HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MINECRAFT" FontSize="22" FontWeight="Bold" Foreground="#FFDB28"
                               FontFamily="Consolas" Effect="{StaticResource PixelShadow}"/>
                    <TextBlock Text="T I C K E T   B O T   ·   v 1 . 0" FontSize="10" Foreground="#FFFFFF"
                               FontFamily="Consolas" FontWeight="Bold" Margin="2,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="40,0,0,0">
                    <TextBlock Text="INSTANCES" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas"/>
                    <TextBox x:Name="InstanceCountInput" Text="2" Width="44" Style="{StaticResource Fld}" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="INIT" Click="InitializeGrid_Click" Width="68" Margin="10,0,5,0" Style="{StaticResource BtnCyan}"/>
                    <Button Content="START ALL" Click="StartAll_Click" Style="{StaticResource BtnGreen}" Width="100" Margin="5,0"/>
                    <Button Content="STOP ALL" Click="StopAll_Click" Style="{StaticResource BtnRed}" Width="100" Margin="5,0"/>
                </StackPanel>
                <Button Content="✕" Click="Close_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="40" Height="40"
                        VerticalAlignment="Center" Style="{StaticResource BtnRed}" FontSize="14"/>
            </DockPanel>
        </Border>

        <!-- ═══ Instance Grid ═══ -->
        <ItemsControl x:Name="BotGridDisplay" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" Margin="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Minecraft 物品欄面板 -->
                        <Grid Margin="6">
                            <!-- 外層黑邊 -->
                            <Border Background="#1C1C1C"/>
                            <!-- 內層 stone 紋理（MC inventory 灰底）+ 內凹 bevel -->
                            <Border Margin="3" Background="#828282" BorderThickness="2,2,1,1" BorderBrush="#3F3F3F"/>
                            <!-- 上邊 + 左邊 暗陰影（內凹感） -->
                            <Border Margin="3" Height="2" VerticalAlignment="Top" Background="#3F3F3F"/>
                            <Border Margin="3" Width="2" HorizontalAlignment="Left" Background="#3F3F3F"/>
                            <!-- 下邊 + 右邊 高光 -->
                            <Border Margin="3" Height="2" VerticalAlignment="Bottom" Background="#A4A4A4"/>
                            <Border Margin="3" Width="2" HorizontalAlignment="Right" Background="#A4A4A4"/>

                            <Grid Margin="14,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ── Header (Minecraft 物品欄標題) ── -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <!-- 鑽石 icon (像素方塊) -->
                                    <Border Width="14" Height="14" Background="#5DC9C9" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Border Width="4" Height="4" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#FFDB28"
                                               FontSize="14" VerticalAlignment="Center" FontFamily="Consolas"
                                               Effect="{StaticResource PixelShadow}"/>
                                    <ComboBox SelectedItem="{Binding CfgRunMode}" Style="{StaticResource Cmb}" Width="110" FontSize="11"
                                              Margin="12,0,0,0" Foreground="Black">
                                        <sys:String>API模式</sys:String>
                                        <sys:String>瀏覽器模式</sys:String>
                                    </ComboBox>
                                    <TextBlock Text="{Binding Status}" Foreground="#FFFFFF" Margin="10,0"
                                               VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Content="START" Tag="{Binding}" Click="StartOne_Click" Style="{StaticResource BtnGreen}" Width="62" Margin="0,0,4,0"/>
                                        <Button Content="PAUSE" Tag="{Binding}" Click="PauseOne_Click" Style="{StaticResource BtnYellow}" Width="62" Margin="0,0,4,0"/>
                                        <Button Content="STOP" Tag="{Binding}" Click="StopOne_Click" Style="{StaticResource BtnRed}" Width="62"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- 像素分隔線 -->
                                <Rectangle Grid.Row="1" Height="2" Margin="0,0,0,8">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#1C1C1C" Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- ── Config Panel (MC inventory slot 風格) ── -->
                                <Border Grid.Row="2" Padding="10,8" Margin="0,0,0,8"
                                        BorderBrush="#1C1C1C" BorderThickness="2"
                                        Background="#5C5C5C"/>
                                <Border Grid.Row="2" Padding="10,8" Margin="0,0,0,8"
                                        BorderBrush="#3F3F3F" BorderThickness="2,2,1,1"
                                        Background="#6F6F6F">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="0.6*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Platform / Slug / Time / Amount -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="PLATFORM" Style="{StaticResource Lbl}"/>
                                            <ComboBox SelectedItem="{Binding CfgPlatform}" Style="{StaticResource Cmb}" Foreground="Black">
                                                <sys:String>TIXCRAFT</sys:String>
                                                <sys:String>KKTIX</sys:String>
                                                <sys:String>TICKETPLUS</sys:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Text="ACTIVITY SLUG" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgActivitySlug, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,6,0">
                                            <TextBlock Text="START TIME" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgTargetTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" IsEnabled="{Binding CfgEnableTimer}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="3">
                                            <TextBlock Text="QTY" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgTicketAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>

                                        <!-- Row 1: Area mode / keyword / exclude / date -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="AREA MODE" Style="{StaticResource Lbl}"/>
                                            <ComboBox SelectedItem="{Binding CfgAreaMode}" Style="{StaticResource Cmb}">
                                                <sys:String>關鍵字優先</sys:String>
                                                <sys:String>由上而下</sys:String>
                                                <sys:String>由下而上</sys:String>
                                                <sys:String>隨機</sys:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Text="AREA KEYWORD" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgAreaKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,6,0">
                                            <TextBlock Text="EXCLUDE (;)" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgExcludeKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3">
                                            <TextBlock Text="DATE" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgDateKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>

                                        <!-- Row 2: Presale / Watch URL / Checkboxes -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="PRESALE CODE" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgPresaleCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,6,0">
                                            <TextBlock Text="WATCH URL (BROWSER MODE)" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgWatchUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                            <CheckBox Content="TIMER" IsChecked="{Binding CfgEnableTimer}" Style="{StaticResource Chk}"/>
                                            <CheckBox Content="PROXY POOL" IsChecked="{Binding CfgUseProxyPool}" Style="{StaticResource Chk}"/>
                                        </StackPanel>

                                        <!-- Row 3: Cookie -->
                                        <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Margin="0,4,0,0">
                                            <TextBlock Text="COOKIE" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgCookie, UpdateSourceTrigger=LostFocus}"
                                                     Foreground="#FFFFFF" Background="#000000"
                                                     BorderBrush="#1C1C1C" BorderThickness="2"
                                                     CaretBrush="#FFDB28" SelectionBrush="#5DC9C9"
                                                     FontSize="12" Padding="6,3"
                                                     FontFamily="Consolas"
                                                     TextWrapping="NoWrap" AcceptsReturn="False"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     MinHeight="24"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Log Output (Minecraft 控制台) ── -->
                                <Border Grid.Row="3" BorderBrush="#1C1C1C" BorderThickness="2" Background="#000000">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#3F3F3F" Padding="8,3" BorderBrush="#1C1C1C" BorderThickness="0,0,0,2">
                                            <TextBlock Text="&gt; S Y S T E M   L O G" FontSize="11" Foreground="#FFDB28" FontFamily="Consolas" FontWeight="Bold"/>
                                        </Border>
                                        <TextBox Grid.Row="1" Text="{Binding Logs}" Background="Transparent" Foreground="#7FBF54"
                                                 BorderThickness="0" IsReadOnly="True" AcceptsReturn="True" FontSize="11"
                                                 FontFamily="Consolas" Padding="8,4"
                                                 VerticalAlignment="Stretch"
                                                 TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto" TextChanged="Log_TextChanged">
                                            <TextBox.Template>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Background="Transparent"
                                                                  Focusable="False"
                                                                  HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                                                </ControlTemplate>
                                            </TextBox.Template>
                                        </TextBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
