<Window x:Class="TicketBotWarRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAR-ROOM MATRIX" WindowState="Maximized" WindowStyle="None"
        Background="#121212" Foreground="#E0E0E0" FontFamily="Microsoft JhengHei">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,3,0,1"/>
        </Style>
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="Cmb" TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BtnGreen" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="BtnRed" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="BtnYellow" TargetType="Button">
            <Setter Property="Background" Value="#F9A825"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Top Bar ═══ -->
        <Border Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0">
                <TextBlock Text="WAR-ROOM MATRIX" FontSize="18" FontWeight="Bold" Foreground="#00FF41" VerticalAlignment="Center" Margin="0,0,30,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="實例數量" FontSize="10" Foreground="#888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="InstanceCountInput" Text="2" Width="36" Background="#2D2D2D" Foreground="White" BorderBrush="#444" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="初始化" Click="InitializeGrid_Click" Width="60" Margin="10,0" Padding="0,6" Background="#2196F3" Foreground="White" BorderThickness="0"/>
                    <Button Content="全部啟動" Click="StartAll_Click" Style="{StaticResource BtnGreen}" Width="70" Margin="5,0" Padding="0,6"/>
                    <Button Content="全部停止" Click="StopAll_Click" Style="{StaticResource BtnRed}" Width="70" Margin="5,0" Padding="0,6"/>
                </StackPanel>
                <Button Content="X" Click="Close_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="36" Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="16" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <!-- ═══ Instance Grid ═══ -->
        <ScrollViewer Grid.Row="1" Background="#0A0A0A" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BotGridDisplay">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Margin="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Margin="5" CornerRadius="4">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ── Header ── -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#00FF41" FontSize="13" VerticalAlignment="Center"/>
                                    <Border Background="#333" CornerRadius="3" Padding="2,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <ComboBox SelectedItem="{Binding CfgRunMode}" Style="{StaticResource Cmb}" Width="90" FontSize="10">
                                            <ComboBoxItem Content="API模式"/>
                                            <ComboBoxItem Content="瀏覽器模式"/>
                                        </ComboBox>
                                    </Border>
                                    <TextBlock Text="{Binding Status}" Foreground="#AAA" Margin="8,0" VerticalAlignment="Center" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Content="啟動" Tag="{Binding}" Click="StartOne_Click" Style="{StaticResource BtnGreen}" Width="46" Margin="0,0,3,0"/>
                                        <Button Content="暫停" Tag="{Binding}" Click="PauseOne_Click" Style="{StaticResource BtnYellow}" Width="46" Margin="0,0,3,0"/>
                                        <Button Content="停止" Tag="{Binding}" Click="StopOne_Click" Style="{StaticResource BtnRed}" Width="46"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- ── Config Panel ── -->
                                <Border Grid.Row="1" Background="#111" CornerRadius="3" Padding="8,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="0.6*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Platform / Slug / Time / Timer toggle -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="平台" Style="{StaticResource Lbl}"/>
                                            <ComboBox SelectedItem="{Binding CfgPlatform}" Style="{StaticResource Cmb}">
                                                <ComboBoxItem Content="TIXCRAFT"/>
                                                <ComboBoxItem Content="KKTIX"/>
                                                <ComboBoxItem Content="TICKETPLUS"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,5,0">
                                            <TextBlock Text="活動 Slug" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgActivitySlug, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,5,0">
                                            <TextBlock Text="開賣時間" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgTargetTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="3">
                                            <TextBlock Text="張數" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgTicketAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>

                                        <!-- Row 1: Area mode / keyword / exclude / date -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="選位策略" Style="{StaticResource Lbl}"/>
                                            <ComboBox SelectedItem="{Binding CfgAreaMode}" Style="{StaticResource Cmb}">
                                                <ComboBoxItem Content="關鍵字優先"/>
                                                <ComboBoxItem Content="由上而下"/>
                                                <ComboBoxItem Content="由下而上"/>
                                                <ComboBoxItem Content="隨機"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,5,0">
                                            <TextBlock Text="區域關鍵字" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgAreaKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,5,0">
                                            <TextBlock Text="排除關鍵字 (;分隔)" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgExcludeKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3">
                                            <TextBlock Text="場次篩選" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgDateKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>

                                        <!-- Row 2: Presale / Watch URL / Checkboxes -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="會員碼/預購碼" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgPresaleCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,5,0">
                                            <TextBlock Text="監控網址 (瀏覽器模式)" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgWatchUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                            <CheckBox Content="定時啟動" IsChecked="{Binding CfgEnableTimer}" Style="{StaticResource Chk}"/>
                                        </StackPanel>

                                        <!-- Row 3: Cookie (full width) -->
                                        <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Margin="0,2,0,0">
                                            <TextBlock Text="Cookie" Style="{StaticResource Lbl}"/>
                                            <TextBox Text="{Binding CfgCookie, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" MaxHeight="34" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ── Log Output ── -->
                                <TextBox Grid.Row="2" Text="{Binding Logs}" Background="#000" Foreground="#00FF41" IsReadOnly="True" AcceptsReturn="True" FontSize="11" FontFamily="Consolas" MinHeight="120" VerticalScrollBarVisibility="Auto" TextChanged="Log_TextChanged"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
