# config.py.example — 設定範本，複製成 config.py 後填入自己的值
#
#   copy config.py.example config.py     (Windows)
#   cp config.py.example config.py       (macOS/Linux)
#
# config.py 本身已加進 .gitignore，不會被 git 追蹤，改動只留在本機。
import os

# --- 平台選擇 ---
# "TIXCRAFT" = 拓元售票 | "KKTIX" = KKTIX
PLATFORM = "TIXCRAFT"

# --- 帳號 ---
COOKIE = ""  # 拓元登入後的完整 cookie 字串（COOKIE_SOURCE="string" 時用）

# cookie 來源:
#   "string"   = 直接用上面的 COOKIE 字串
#   "userdata" = bot 開 Chrome（用 CHROME_USER_DATA_DIR 的 profile）自己抓 cookie
COOKIE_SOURCE = "string"
CHROME_USER_DATA_DIR = ""  # COOKIE_SOURCE="userdata" 時，Chrome profile 資料夾路徑

# --- 活動設定 ---
ACTIVITY_SLUG = ""               # 活動 slug（從活動 URL 取）
TICKET_AMOUNT = "1"              # 購票張數
AREA_KEYWORD = ""                # 區域/價格關鍵字篩選（空字串 = 依選位策略）
AREA_AUTO_SELECT_MODE = "關鍵字優先"  # 選位策略: 關鍵字優先 / 由上而下 / 由下而上 / 隨機
CLEAR_MODE = "寬鬆"               # 清票模式: 嚴格(只買關鍵字命中的) / 寬鬆(位置與剩餘量取平衡)
REQUIRE_FULL_AMOUNT = False      # True = 剩餘量 < TICKET_AMOUNT 的票種直接跳過(不買少一點)
GRAB_DELAY_AFTER_OPEN = 0.0      # 遠大專用：開賣後延遲幾秒才送單(避開開賣瞬間的 CDN 舊快取/空排)；0=不延遲
EXCLUDE_AREA_KEYWORD = "輪椅;身障;身心;障礙;Restricted View;燈柱遮蔽;視線不完整;身障票"
DATE_KEYWORD = ""                # 場次日期篩選（空字串 = 選第一場）
PRESALE_CODE = ""                # 會員碼 / presale code（空字串 = 不使用，頁面有答案會自動抓）

# livenation 模式（搭配 COOKIE_SOURCE="userdata"）：browser 從這個 URL 開始而非 /login。
# 例 "https://www.livenation.com.tw/event/xxxx/"。空字串 = 走 default /login 流程。
LIVENATION_START_URL = ""

# --- 時間與監控 ---
ENABLE_TIME_WATCHER = False       # 是否啟用定時等待
TARGET_START_TIME = "12:00:00"   # 目標開賣時間 HH:MM:SS
ADVANCE_MS = 150                 # 提前毫秒數
TIME_WATCH_URL = ""              # 監控網址（定時對時用）

# --- 視窗平鋪 (GUI 多開時覆寫) ---
ACC_ID = 0
WINDOW_X = -1
WINDOW_Y = -1
WINDOW_W = -1
WINDOW_H = -1

# --- 重試與輪詢 ---
RETRY_INTERVAL = 0.3             # 主迴圈重試間隔（秒）
CAPTCHA_MAX_RETRY = 5            # 驗證碼辨識重試次數
TICKET_CAPTCHA_RETRY = 5         # 驗證碼錯誤重試輪數
ORDER_POLL_INTERVAL = 5.0        # 排隊輪詢間隔（秒）— 進 order 後純等待，不拚速度
ORDER_POLL_MAX = 180             # 排隊輪詢最大次數（5s × 180 = 15 分鐘上限）

# --- LINE 推播（搶到票後通知客人匯款 + 自行結帳） ---
ENABLE_LINE_NOTIFY = True        # 全域開關；LINE_USER_ID 為空的 instance 自然不會推
LINE_CHANNEL_ACCESS_TOKEN = ""   # LINE Developers Console → Messaging API → Channel access token
LINE_CHANNEL_SECRET = ""         # 同上 → Channel secret（部署 LineBotWorker 時用 wrangler secret put 設定）
LINE_USER_ID = ""                # 這個 instance 對應客人的 LINE userId（客服 bot 登記取得）
TICKET_FEE = ""                  # 這個 instance 的搶票費（每個客人不同，GUI 卡片填）
PAYMENT_INFO = "銀行代碼：\n帳號："  # 匯款資訊（訊息裡原樣顯示，填自己的收款帳戶）

# 客服選單 / 搶票登記邏輯跑在 Cloudflare Workers（LineBotWorker/），webgui 讀寫客人
# 名單要打這個 API，ADMIN_KEY 要跟 Worker 的 `wrangler secret put ADMIN_KEY` 設的值一致
LINE_WORKER_URL = ""             # 部署後填，例如 "https://linebot-ticket.xxx.workers.dev"
LINE_WORKER_ADMIN_KEY = ""       # 建議用 `python -c "import secrets; print(secrets.token_urlsafe(32))"` 生一組

# --- Proxy Pool (CliProxy 住宅 IP) ---
ENABLE_PROXY_POOL = False                        # 是否啟用 CliProxy（每個 instance 獨立 IP）
CLIPROXY_HOST = ""                               # 例 "sg2.cliproxy.io"
CLIPROXY_PORT = 3010
# {acc_id} 會被 ACC_ID 替換 → 每個 instance 不同 sid → 不同出口 IP
CLIPROXY_USERNAME_TEMPLATE = ""                  # 例 "your_account-region-TW-sid-acc{acc_id}-t-90"
CLIPROXY_PASSWORD = ""
CURRENT_PROXY = ""                               # 執行期由 proxy_pool.acquire() 寫入

# --- 多 IP 出口（美國 VPS 專用，取代 proxy 做多開隔離）---
# 拓元 origin 在美東，Oracle Ashburn 直連約 60ms（家裡走 CliProxy 是 331ms）。多開時
# 不用 proxy 換 IP，改成一台機器掛多顆公網 IP，每個 instance 綁一顆自己的次要私有 IP。
# 填 OCI VNIC 上的**次要私有 IP**（例 "10.0.0.88"），空字串 = 走預設路由（主 IP）。
# curl_cffi 和 Chrome 都會綁這顆 —— 兩邊必須一致，因為 eps_sid 綁發放時的出口 IP。
# 機器上要先掛好：rotate_ips.py --sync-os（開機由 systemd 自動跑）
LOCAL_BIND_IP = ""

# --- 系統路徑 ---
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
